# Build output
dist/
.output/

# Astro
.astro/

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# Environment / secrets — never commit
.env
.env.*
!.env.example

# OS / editor machine state
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Misc caches
*.tsbuildinfo

# Lighthouse CI reports (local artifacts)
.lighthouseci/

# AI design tooling installed locally (dev-time only; not part of the static
# build/deploy). Impeccable skill — reinstall with:
#   npx impeccable@3.2.1 install --providers=claude --project --no-hooks --yes
.claude/skills/impeccable/
.claude/settings.local.json

# Impeccable tool state (live-mode config, proof assets) — dev-time only.
.impeccable/

# Python bytecode. The control's own tests write it beside them, and an untracked
# folder is a dirty tree, which is what `loop.py start` refuses.
__pycache__/

# A card's pictures are evidence, not history. Git never forgets a blob once it
# has one, so these are ignored from the day the control landed rather than later.
control/cards/*/before/
control/cards/*/after/
