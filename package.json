{
  "name": "solo-dev-portfolio-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Static-first premium-minimal solo developer portfolio and store-support website.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "audit": "npm audit --omit=dev",
    "headless": "npm run audit && npm run build && npm run check && npm test && npm run test:dist",
    "capture": "node scripts/capture.mjs",
    "lhci": "lhci autorun",
    "test:live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.0.0",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "puppeteer-core": "^25.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "yaml": "$yaml"
  }
}
