{
  "name": "solo-dev-portfolio-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Static-first premium-minimal solo developer portfolio and store-support website.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "audit": "npm audit --omit=dev",
    "headless": "npm run audit && npm run build && npm run check && npm test && npm run test:dist",
    "capture": "node scripts/capture.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.0",
    "satteri": "^0.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@lhci/cli": "^0.15.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
