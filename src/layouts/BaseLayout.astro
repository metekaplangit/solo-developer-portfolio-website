---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Schema.org JSON-LD for this page (one object or an array). Optional. */
  schema?: object | object[];
  /**
   * Drop the shared `.container` rail from `<main>` so the page can run bands
   * edge to edge (the Spectrum poster layout, DESIGN.md §1). A page that opts
   * in owns its own rails and must wrap its content in `.rail` — nothing else
   * will keep it aligned with the header and footer.
   *
   * Deliberately not implemented with `calc(50% - 50vw)` bleed inside the
   * container: `scrollbar-gutter: stable` reserves the scrollbar, so `100vw`
   * exceeds the client width and produces horizontal page overflow — the one
   * thing that is never acceptable here.
   */
  bleed?: boolean;
  /**
   * The page has moved to this path. The page then points search engines at
   * the new address, stays out of the index, and sends a browser on at once.
   * For an address already written into a shipped build, which cannot change.
   */
  movedTo?: string;
  /**
   * Skip the view transition when leaving this page. Only for a page served
   * with an error status: Chrome never keeps one in its back-forward cache, and
   * a transition out of a page it cannot keep held the next page's first frame
   * for about 380 ms (issue 0017).
   */
  leaveWithoutTransition?: boolean;
  /**
   * The page has no address of its own: the not-found page, served for every
   * mistyped address. It names no canonical or og:url, since any it named
   * would be an address nothing is built at, and stays out of the index
   * (issue 0021).
   */
  noAddress?: boolean;
}
const { title, description = site.description, schema, bleed = false, movedTo, leaveWithoutTransition = false, noAddress = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(movedTo ?? Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
// Every page this site links to is fetched as soon as a page loads, so a
// first visit answers from the browser's prefetch cache instead of waiting the
// 250–450 ms network round trip (issue 0018). Speculation rules rather than
// Astro's `prefetch`: Chrome and Edge do the fetching themselves, with no
// script, and skip it under Save-Data or battery saver; a browser without them
// (Safari, Firefox in 2026) ignores the rule. Astro's prefetch fell back to
// `fetch()` in Safari, and every page change that cut one short logged an
// error there (plan 0019's loop card). Same-origin only; the pages are 8–28 KB
// of HTML each, and the header's link to the page already open is left out.
// https://developer.chrome.com/docs/web-platform/prerender-pages (read 2026-10-31)
const speculationRules = JSON.stringify({
  prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[aria-current=page]' } }] }, eagerness: 'immediate' }],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Marks an arrival that came through a view transition, so the opening
        waits for the old page to leave (global.css, `.vt-in [data-land]`).
        Classic and inline on purpose: `pagereveal` fires before the first
        frame, which a deferred module script would miss. A transition the
        browser skips (a reload, Back, a resize, a second link) rejects its
        `ready`: caught, so it is not an uncaught error, and the mark comes off,
        so the opening does not wait for a hand-off that never ran (issue 0023).
        Chrome also aborts transitions it never hands to any page, and reports
        their rejection here, where nothing can catch it: only those notices,
        named by the browser as a transition's abort, skip or timeout, are marked
        handled, and every other rejection stays in the console. */}
    <script is:inline>addEventListener('pagereveal', (e) => { const t = e.viewTransition; if (t) { document.documentElement.classList.add('vt-in'); t.ready.catch(() => document.documentElement.classList.remove('vt-in')); } }); addEventListener('unhandledrejection', (e) => { const r = e.reason; if (r && /^(InvalidState|Abort|Timeout)Error$/.test(r.name) && /transition/i.test(r.message)) e.preventDefault(); });</script>
    <script type="speculationrules" is:inline set:html={speculationRules} />
    {leaveWithoutTransition && <script is:inline>addEventListener('pageswap', (e) => e.viewTransition?.skipTransition());</script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090c" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon-180.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noAddress && <link rel="canonical" href={canonical} />}
    {movedTo && <meta http-equiv="refresh" content={`0; url=${withBase(movedTo)}`} />}
    {(movedTo || noAddress) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noAddress && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {schema && <JsonLd schema={schema} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav />
    <main id="main" class={bleed ? undefined : 'container'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
