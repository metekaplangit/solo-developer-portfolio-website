---
// A metadata pill. The shape lives in `.chip` (global.css) — this component is
// the named way to render one, not a second definition of what one looks like.
//
// Note: the neutral badge previously carried a fill AND a `--border` hairline,
// which broke the Single-Cue Rule the policy chips were already following.
// Consolidating settled it in favour of the fill.
interface Props {
  label: string;
  tone?: 'neutral' | 'accent' | 'muted';
}
const { label, tone = 'neutral' } = Astro.props;
const toneClass = tone === 'accent' ? 'chip-accent' : tone === 'muted' ? 'chip-quiet' : '';
---

<span class={`chip ${toneClass}`.trim()}>{label}</span>
