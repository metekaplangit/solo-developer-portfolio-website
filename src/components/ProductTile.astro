---
// One product as a single tappable row: its icon, its name, one quiet line
// under the name, and an arrow. Shared by every list of products that only
// needs to name and link them — the support page's product list, a product
// page's "More apps", and the per-product privacy policies — so a product is
// recognised by its icon wherever it is listed, not by a bare word.
//
// The whole tile is the link, so the target is the full row rather than the
// name's line box. The icon is decorative here: the name beside it is the
// link's text.
import ProductAvatar from './ProductAvatar.astro';
import type { Product } from '../content/schema';
import { platformLabel } from '../lib/products';
import { withBase } from '../lib/url';

interface Props {
  product: Product;
  href: string;
  /** The line under the name. Defaults to what the product is and runs on. */
  line?: string;
  /** Visually hidden words after the name, when the line alone does not say where the link goes. */
  hint?: string;
  /** Inside the first screen? Passed to the icon — see `ProductAvatar`'s `eager`. */
  eager?: boolean;
}
const { product, href, line, hint, eager = false } = Astro.props;
const kind = product.type === 'game' ? 'Game' : 'App';
const text = line ?? [kind, ...product.platforms.map(platformLabel)].join(' · ');
---

<a class="tile" href={withBase(href)}>
  <ProductAvatar icon={product.icon} name={product.name} size={48} eager={eager} />
  <span class="tile-text">
    <span class="tile-name">{product.name}{hint && <span class="visually-hidden"> {hint}</span>}</span>
    <span class="tile-line">{text}</span>
  </span>
  <svg class="tile-go" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  /* Single cue: the lifted surface, no border (DESIGN.md §4). */
  .tile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4) var(--space-5) var(--space-4) var(--space-4);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface), var(--surface-2));
    color: var(--text);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .tile:hover {
    color: var(--text-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .tile:active {
    transform: translateY(0) scale(0.99);
    transition-duration: 90ms;
  }
  .tile-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .tile-name {
    font-size: var(--text-base);
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .tile-line {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  .tile-go {
    color: var(--faint);
    transition: transform var(--dur) var(--ease), color var(--dur-fast) var(--ease);
  }
  .tile:hover .tile-go {
    color: var(--text-strong);
    transform: translateX(2px);
  }
</style>
