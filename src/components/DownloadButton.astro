---
// Prominent, reusable download CTA (STEP-0028). Renders the product's first
// actionable store link as a branded primary button with the studio's download
// mark — so every relevant page can surface the download at the top. Renders
// nothing when the product has no available link (unreleased products degrade
// gracefully). Data-driven from the product content file; no per-page URLs.
import type { Product } from '../content/schema';
import { visibleStoreLinks, storeLabel } from '../lib/products';

interface Props {
  product: Product;
  /** 'md' (default) for page headers/heroes, 'sm' for compact cards. */
  size?: 'md' | 'sm';
  /**
   * Override the visible label (default: "Download").
   *
   * Keep any override SHORT — long button labels were removed deliberately.
   * The accessible name is unaffected: the `aria-label` below always spells out
   * "Download <product> on the <store>", so screen-reader users still get the
   * product and destination even though the visible text is one word.
   *
   * WCAG 2.5.3 (Label in Name) requires the accessible name to contain the
   * visible label, so an override must be a substring of that aria-label —
   * "Download" and "Mac App Store" both are. "Get it now" would not be.
   */
  label?: string;
  /**
   * 'neutral' (default) is studio chrome — the achromatic fill used anywhere on
   * the site. 'hue' is only legal inside a band that this product owns, where
   * `--hue` has been re-declared from the product's own colour (DESIGN.md §2,
   * One Voice Per Band).
   */
  tone?: 'neutral' | 'hue';
}
const { product, size = 'md', label, tone = 'neutral' } = Astro.props;

const link = visibleStoreLinks(product).find((l) => l.status === 'available');
---

{
  link && (
    <a
      class={`btn ${tone === 'hue' ? 'btn-hue' : 'btn-primary'} ${size === 'sm' ? 'btn-sm' : 'btn-lg'} download-btn`}
      href={link.url}
      rel="noopener"
      target="_blank"
      aria-label={`Download ${product.name} on the ${storeLabel(link.store)}`}
    >
      <svg viewBox="0 0 20 20" aria-hidden="true" class="get-mark">
        <path d="M10 3v9.5M5.5 8.5 10 13l4.5-4.5M5 17h10" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="download-label">{label ?? 'Download'}</span>
    </a>
  )
}

<style>
  /* Height and padding come from the shared `.btn-lg` / `.btn-sm` set — the
     main action stands out through its fill, the download mark and its wider
     label, never through a one-off height (One Height Per Set). */
  /* The studio's own download mark, drawn on the gallery chevrons' grid with
     their round ends. Apple's App Store marketing guidelines say "Don't use the
     standalone Apple logo", so the mark is ours rather than theirs (issue 0004). */
  .get-mark {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }
</style>
