---
import { nav, site } from '../lib/site';
import { withBase } from '../lib/url';
const { pathname } = Astro.url;
const norm = (s: string): string => s.replace(/\/+$/, '') || '/';
function isCurrent(href: string): boolean {
  const target = norm(withBase(href));
  const here = norm(pathname);
  if (href === '/') return here === target;
  return here === target || here.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <img class="brand-mark" src={withBase('/favicon.svg')} alt="" width="28" height="28" />
      <span>{site.brand}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list" role="list">
        {
          nav.map((item) => (
            <li class={item.href === '/' ? 'nav-home' : undefined}>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {isCurrent(item.href) && <span class="nav-pill" aria-hidden="true" />}
                <span class="nav-label" data-text={item.label}>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Translucent "liquid glass" sticky header — Apple depth cue. */
  .site-header {
    /* Named, so it is snapshotted separately from the page body and holds
       still across a navigation instead of cross-fading against itself. */
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
  }

  /* ATTEMPTED AND REMOVED (STEP-0055, 2026-08-01): a scroll-driven "settle"
     that faded the hairline in over the first 120px. The timeline attached
     correctly — `getAnimations()` returned a real `ScrollTimeline` — but its
     progress stayed `null` and the computed border never moved, across three
     attempts (bare `scroll()`, then longhand properties, then an explicit
     `scroll(root block)` after checking MDN). Unprovable in the harness
     available here, and an effect that cannot be shown to work is not one to
     ship. The header keeps the hairline it has always had. Do not re-attempt
     without a way to observe scroll-timeline progress on this machine. */

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-display);
    font-size: var(--text-base);
    letter-spacing: var(--track-optical);
    text-decoration: none;
    color: var(--text-strong);
  }
  .brand-mark {
    width: 28px;
    height: 28px;
    /* An app-icon mask, not a UI surface: `--radius-icon`, the same
       proportion every product icon uses, so the mark reads as an app's icon
       rather than as another rounded chip in the header. */
    border-radius: var(--radius-icon);
    display: block;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a {
    position: relative;
    isolation: isolate;
    display: inline-block;
    text-decoration: none;
    color: var(--muted);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .nav-list a:hover {
    color: var(--text-strong);
    background: var(--surface-2);
  }
  .nav-list a[aria-current='page'] {
    color: var(--text-strong);
    font-weight: var(--weight-strong);
  }
  /* Every label keeps the width it has in bold, so the current item turning
     bold never pushes its neighbours along. Without it the row shifted on
     every page change, and the header's old and new snapshots disagreed by
     a few pixels: the labels doubled mid-transition. The hidden bold copy
     is a zero-height second grid row, out of the accessibility tree; the
     text is centred in that width, so regular and bold share a middle and
     the cross-fade between them stays in place. */
  .nav-label {
    display: inline-grid;
    justify-items: center;
  }
  .nav-label::after {
    content: attr(data-text);
    font-weight: var(--weight-strong);
    visibility: hidden;
    height: 0;
    overflow: hidden;
  }
  /* The current page's pill is its own empty element behind the label, not
     the link's background, so a view transition can carry the pill from the
     old page's item to the new one while the labels hold still in the
     header (plan 0011; the travel rules are in global.css). */
  .nav-pill {
    view-transition-name: nav-pill;
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--accent-soft);
  }

  /* Narrow screens. History: review-0001 OPP-01 replaced a two-row wrap
     (~146px of header) with a single horizontally-scrollable row. That fixed
     the height but hid destinations: measured at 390px, the row was 466px wide
     inside a 331px box — "Support" clipped mid-word and **"About" entirely
     off-screen** (401-466px), behind a mask fade that reads as a rendering
     glitch rather than an affordance. On a site whose whole argument is that a
     real person is behind it, About is the page that carries that, and phone
     visitors could not see it existed.

     The fix is to remove an item rather than to scroll or to wrap. The brand
     lockup to the left IS the home link, so a separate "Home" entry is pure
     redundancy — and dropping it on narrow screens buys back exactly the width
     the row was short. The remaining four destinations then fit on ONE visible
     row with no scroll, no mask, and nothing hidden.

     Wrapping to two rows was tried and rejected: with the `pointer: coarse`
     rule below raising links to 44px, two rows cost ~144px of header on a real
     phone — the very height the 2023 scroll fix existed to avoid. One row of
     four keeps the header at ~93px AND keeps every link a 44px target. */
  @media (max-width: 40rem) {
    .header-inner {
      padding-block: var(--space-3);
      row-gap: var(--space-2);
    }
    .site-header nav {
      width: 100%;
    }
    .nav-list {
      /* One row whenever the four fit — from ~360px up at normal text
         (measured: 0px hidden at 390 and 430). Where they cannot — a narrower
         window, or text raised to 150% and more — the row wraps rather than
         scrolling: a scrolled row hid Support and About past the edge with
         nothing showing they were there (issue 0022), and a second row costs
         height only on the screens that could not show the first one whole. */
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-1);
      font-size: var(--text-sm);
      /* Safety valve, not the design: only a single link wider than the whole
         row could reach it. Scrolling a nav is a poor outcome; scrolling the
         page sideways is a broken one. No mask here: the fade it used to draw
         read as a rendering glitch rather than an affordance. */
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav-list::-webkit-scrollbar {
      display: none;
    }
    /* Redundant with the brand link at this width. */
    .nav-home {
      display: none;
    }
    .nav-list a {
      white-space: nowrap;
      padding-inline: var(--space-2);
    }
  }

  /* Touch ergonomics (review-0001 OPP-08): comfortable ≥44px hit height on
     coarse pointers without changing the visual pill design on desktop. */
  @media (pointer: coarse) {
    .nav-list a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }
</style>
