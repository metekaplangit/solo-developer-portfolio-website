---
// First-glance facts (STEP-0031, review-0002 COMP-01/USER-02/USER-05; wrapping
// polished in STEP-0037). One quiet middot-separated line of the decision facts
// a visitor needs before clicking through to the store: price today, and the
// system requirement. Every fact is derived from structured product content that
// is already verified elsewhere — this component presents truth, it never
// creates it. Renders nothing when a product has no facts yet.
//
// It carried a third fact until 2026-09-10 — a privacy line reading "Works
// offline — no account, no cloud, no tracking" — and the price fact went on to
// say "no in-app purchases, no subscription". Both were promises about what the
// studio would never do rather than facts about the product, and both are gone.
// Price and requirement stay because they are what the store listing says today.
import type { Product } from '../content/schema';
import { tie } from '../lib/typography';

interface Props {
  product: Product;
}
const { product } = Astro.props;

const facts: string[] = [];
if (product.price === '0') facts.push('Free');
else if (product.price != null) facts.push(`$${product.price} (one-time)`);
if (product.requirements) facts.push(product.requirements);
---

{
  facts.length > 0 && (
    <p class="facts-line">
      {facts.map((f) => (
        // Each fact is its own flex item, so the row breaks between facts — but
        // a single fact is long enough to wrap inside itself ("macOS 10.15 or
        // later"), and those endings were untied (CHECKLIST T1).
        <span class="fact">{tie(f)}</span>
      ))}
    </p>
  )
}

<style>
  /* Flex-wrap, NOT nowrap spans. Each fact is a flex item, so the row breaks
     between facts (never mid-phrase) while the element's min-content width stays
     one word — not the full 828px run. `white-space: nowrap` here previously
     forced the whole line to be unbreakable, which starved the featured image
     column (13-234px instead of ~630px) and overflowed the page between ~417px
     and ~880px. Never reintroduce it. */
  .facts-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  /* Separator on the FOLLOWING fact, not a trailing `::after` on the previous
     one. With `::after` the middot travelled with the item before the break,
     so on wrap it dangled at the end of a line with nothing after it — once at
     770px, twice at 390px. As a `::before` it always leads the item it
     separates, so a wrapped line never ends on a stray dot. */
  .fact:not(:first-child)::before {
    content: '·';
    margin-inline: 0.55em;
    color: var(--faint);
  }
</style>
