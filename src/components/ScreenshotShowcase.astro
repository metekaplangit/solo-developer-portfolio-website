---
// Product screenshot gallery. Each shot is a complete, self-contained marketing
// scene (headline + background baked in), so we frame one large at a time and let
// arrows move between them instead of stacking — the section stays compact even
// with 20+ shots. Built on a CSS scroll-snap track: native swipe + trackpad work
// with zero JS, and a small progressive-enhancement script wires the arrows,
// keyboard, and counter on top. Motion honours prefers-reduced-motion.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Shot {
  img: ImageMetadata;
  alt: string;
  /**
   * Short humanized title. Carried because the content files author it and the
   * schema keeps it; nothing in this component renders it since STEP-0074
   * removed the transcript disclosure.
   */
  title?: string;
}
interface Props {
  shots: Shot[];
  label?: string;
}
const { shots, label = 'Screenshots' } = Astro.props;
const many = shots.length > 1;
// Phone captures are portrait. The carousel frame below is cut for a Mac
// window at 2880:1800, and a portrait shot forced into it is squashed, or at
// its own ratio a single slide stands taller than the screen. So a product
// whose shots are taller than wide gets a phone rail instead: four whole shots
// side by side on a wide screen (two on a phone), and arrows that page through
// the rest — the owner's call, 2026-09-29, so every capture stays reachable.
const portrait = shots.length > 0 && shots[0].img.height > shots[0].img.width;
/** How many phone shots the rail shows at once on a wide screen. */
const PHONES_WIDE = 4;
---

{
  portrait && (
    <section class="phones reveal" aria-roledescription="carousel" aria-label={label} data-phones>
      <div class="phone-frame">
        <ul
          class="phone-track"
          role="list"
          tabindex="0"
          aria-label={`${label} — use the left and right arrow keys to see more`}
        >
          {shots.map((shot, i) => (
            <li class="phone" aria-label={`Screenshot ${i + 1} of ${shots.length}`}>
              {/* The first four are the rail's first view on a wide screen, so
                  they load at once (a lazy image on the first screen is queued
                  late for nothing — the geometry suite's rule); the rest sit
                  off to the side until the arrows bring them in. */}
              <Image
                src={shot.img}
                alt={shot.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 74rem) 17rem, (min-width: 40rem) calc((100vw - 6rem) / 4), calc((100vw - 3.5rem) / 2)"
                format="webp"
                quality={80}
                loading={i < PHONES_WIDE ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="phone-img"
                draggable={false}
              />
            </li>
          ))}
        </ul>
        {shots.length > 2 && (
          <>
            <button type="button" class="nav prev" aria-label="Previous screenshots" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
                <path d="M12.25 4 6.25 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button type="button" class="nav next" aria-label="Next screenshots" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
                <path d="M7.75 4 13.75 10l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </>
        )}
      </div>
      {shots.length > 2 && (
        <p class="phone-count" aria-live="polite" hidden>
          <span class="phone-from">1</span>–<span class="phone-to">{Math.min(PHONES_WIDE, shots.length)}</span> of {shots.length}
        </p>
      )}
    </section>
  )
}

{
  !portrait && shots.length > 0 && (
    <section class="gallery reveal" aria-roledescription="carousel" aria-label={label}>
      <div class="frame">
        <ul
          class="track"
          role="list"
          tabindex="0"
          aria-label={`${label} — use the left and right arrow keys to move between screenshots`}
        >
          {shots.map((shot, i) => (
            <li class="slide" aria-label={`Screenshot ${i + 1} of ${shots.length}`}>
              {/* The first slide is the largest thing on this page's first
                  screen, so it is the LCP element and the ONE image here that
                  gets a priority hint. Slides 2-5 stay lazy — marking every
                  slide high is the same as marking none. */}
              <Image
                src={shot.img}
                alt={shot.alt}
                widths={[720, 1080, 1440, 1920]}
                sizes="(min-width: 74rem) 72rem, calc(100vw - 3rem)"
                format="webp"
                quality={78}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="shot-img"
                draggable={false}
              />
            </li>
          ))}
        </ul>

        {many && (
          <>
            <button type="button" class="nav prev" aria-label="Previous screenshot" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
                <path
                  d="M12.25 4 6.25 10l6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button type="button" class="nav next" aria-label="Next screenshot" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
                <path
                  d="M7.75 4 13.75 10l-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <p class="chip chip-glass counter" aria-hidden="true">
              <span class="counter-now">1</span> / {shots.length}
            </p>
          </>
        )}
      </div>

      {many && (
        <div class="dots-area">
          <div class="dots-rail" style={`--n:${shots.length}`}>
            <ul class="dots" role="list" aria-label="Choose screenshot">
              {shots.map((_, i) => (
                <li>
                  <button
                    type="button"
                    class="dot"
                    data-index={i}
                    aria-label={`Go to screenshot ${i + 1}`}
                  />
                </li>
              ))}
            </ul>
            <span class="dot-marker" aria-hidden="true" />
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  .phones {
    max-width: 72rem;
    margin-inline: auto;
  }
  .phone-frame {
    position: relative;
  }
  .phone-track {
    --gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .phone-track::-webkit-scrollbar {
    display: none;
  }
  .phone-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .phone {
    /* Two whole shots per view on a phone, four from 40rem. */
    flex: 0 0 calc((100% - var(--gap)) / 2);
    min-width: 0;
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
    /* The same hairline ring as the carousel frame, per shot. */
    border: 1px solid var(--border);
    line-height: 0;
  }
  @media (min-width: 40rem) {
    .phone-track {
      --gap: var(--space-6);
    }
    .phone {
      flex-basis: calc((100% - 3 * var(--gap)) / 4);
    }
  }
  .phone-img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
  }
  /* On a phone the rail runs to the gutter, so the arrows sit just inside it;
     an arrow pushed past the edge was cut off by the screen. From 64rem there
     is room beside the rail, and they straddle its edges so they never cover
     the middle of a shot. */
  .phones .nav.prev {
    left: var(--space-2);
  }
  .phones .nav.next {
    right: var(--space-2);
  }
  @media (min-width: 64rem) {
    .phones .nav.prev {
      left: 0;
      transform: translate(-35%, -50%);
    }
    .phones .nav.next {
      right: 0;
      transform: translate(35%, -50%);
    }
  }
  .phone-count {
    margin: var(--space-4) 0 0;
    text-align: center;
    color: var(--muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .gallery {
    /* Breaks out well past the prose column — the screenshots are the most
       prominent element on the page (STEP-0036). Centered on the same axis. */
    max-width: 72rem;
    margin-inline: auto;
    /* No padding-block. The band around this gallery already owns the space
       above and below it, and setting both made one gap out of two rhythms —
       120px of band plus 24px of padding, a 144px void the owner boxed on the
       live page. Space belongs to one owner (CHECKLIST W2). */
  }
  .frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    /* Hairline ring + soft lift so light-backed scenes still read on the dark page. */
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  /* Scroll-snap rail: one slide per viewport, native swipe/trackpad without JS. */
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Hide the scrollbar — arrows/dots are the affordance. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  /* The track is focusable (keyboard scroll access) — show it when tabbed to. */
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2880 / 1800;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Arrows — circular glass buttons floated over the left/right edges. */
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    /* The shared glass of `.chip-glass` — fill, hairline and blur, mixed from
       `--bg` so it follows the stage — and no lift shadow on top of it. The
       hairline is the strong one: over a dark shot it is what shows the button. */
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--text-strong);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .nav:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .nav:active {
    transform: translateY(-50%) scale(0.94);
  }
  .nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nav.prev {
    left: var(--space-4);
  }
  .nav.next {
    right: var(--space-4);
  }
  /* At an end the arrow dims and stops taking pointer events, but stays laid out. */
  .nav[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  /* Position counter — the shared `.chip .chip-glass` pill, placed. Its fill,
     blur, hairline and radius come from global.css; only position, margin and
     the tabular figures are local.

     Its fill used to be a hardcoded `rgba(22, 23, 27, 0.6)` — the RETIRED
     graphite ground `#16171b` at 60%, left behind by the Spectrum swap. The
     shared chip mixes from `--bg`, so it cannot go stale again. */
  .counter {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* Dot rail below the frame. One row, always: each dot's slot is its full
     hit area (28px on fine pointers, 44px on touch) unless the row would not
     fit, and then every slot narrows by the same amount instead of the row
     wrapping — a second row would leave the marker below nowhere. The 7px
     mark sits in the middle of each slot (review-0001 OPP-08). */
  .dots-area {
    container-type: inline-size;
    margin-top: var(--space-3);
  }
  .dots-rail {
    --gap: var(--space-1);
    --slot-max: 1.75rem;
    --slot: min(var(--slot-max), (100cqi - (var(--n) - 1) * var(--gap)) / var(--n));
    position: relative;
    width: fit-content;
    margin-inline: auto;
  }
  .dots {
    display: flex;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dot {
    display: grid;
    place-items: center;
    width: var(--slot);
    height: var(--slot-max);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }
  /* Half the text colour: 4.7:1 on the stage, so every dot reads as the
     button it is (issue 0014 — at 30% they were 2.4:1). */
  .dot::after {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--text) 50%, transparent);
    transition:
      background 0.2s var(--ease),
      width 0.25s var(--ease);
  }
  .dot:hover::after {
    background: var(--text);
  }
  /* Without scroll timelines the current mark stretches into a pill: position
     reads from shape as well as colour, and the row never changes height. */
  .dot[aria-current='true']::after {
    width: 22px;
    background: var(--accent);
  }
  .dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .dot-marker {
    display: none;
  }
  /* With them (plan 0011), one marker rides the track's own scroll: it sits
     wherever the slides are, between two dots mid-swipe, and is never told
     where to go. A single animation over the whole scroll range — not one
     per dot over part of it, which WebKit 284526 breaks at the last slide. */
  @supports (animation-timeline: --a) and (timeline-scope: --a) {
    .gallery {
      timeline-scope: --shots;
    }
    .track {
      scroll-timeline: --shots x;
    }
    .dot[aria-current='true']::after {
      width: 7px;
      background: color-mix(in srgb, var(--text) 50%, transparent);
    }
    .dot-marker {
      position: absolute;
      top: 0;
      left: 0;
      display: grid;
      place-items: center;
      width: var(--slot);
      height: var(--slot-max);
      pointer-events: none;
      /* Longhands on purpose: the build's minifier folds a timeline into the
         `animation` shorthand, which no browser accepts, and the whole
         declaration is dropped. */
      animation-name: dot-marker;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --shots;
    }
    .dot-marker::after {
      content: '';
      width: 22px;
      height: 7px;
      border-radius: var(--radius-pill);
      background: var(--accent);
    }
    @keyframes dot-marker {
      to {
        transform: translateX(calc((var(--n) - 1) * (var(--slot) + var(--gap))));
      }
    }
  }
  @media (pointer: coarse) {
    .dots-rail {
      --slot-max: 2.75rem;
    }
  }

  /* Touch devices: native swipe leads, but keep the arrows a comfortable tap size. */
  @media (hover: none) {
    .nav {
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .phone-track {
      scroll-behavior: auto;
    }
    .nav,
    .dot,
    .dot::after {
      transition: none;
    }
  }
</style>

<script>
  // Progressive enhancement: wire arrows, dots, keyboard, and the live counter to
  // the native scroll-snap track. Falls back to plain swipe/scroll if this never runs.
  function initGallery(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.track');
    const prev = root.querySelector<HTMLButtonElement>('.nav.prev');
    const next = root.querySelector<HTMLButtonElement>('.nav.next');
    const counter = root.querySelector<HTMLElement>('.counter-now');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const slides = Array.from(track?.querySelectorAll<HTMLElement>('.slide') ?? []);
    if (!track || slides.length < 2) return;

    let current = 0;
    const leftOf = (i: number) => slides[i].offsetLeft - track.offsetLeft;

    // Where the last press sent the track. A press aims from here rather than
    // from `current`, which only moves once a glide is half done: aimed from it,
    // 3 quick taps on Next moved 1 picture (chaos-project 0001). It is let go
    // once the track arrives, or the moment the visitor moves the track by hand.
    let target: number | null = null;
    const from = () => target ?? current;
    const scrollToIndex = (i: number) => {
      target = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: leftOf(target) });
      if (Math.abs(track.scrollLeft - leftOf(target)) <= 1) target = null;
    };
    const byHand = () => {
      target = null;
    };
    track.addEventListener('pointerdown', byHand, { passive: true });
    track.addEventListener('touchstart', byHand, { passive: true });
    track.addEventListener('wheel', (e) => e.deltaX && byHand(), { passive: true });

    const render = () => {
      if (counter) counter.textContent = String(current + 1);
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
      dots.forEach((d, i) =>
        d.setAttribute('aria-current', i === current ? 'true' : 'false'),
      );
    };

    // Reveal the arrows only once JS is live (they ship hidden so no-JS users
    // aren't shown dead controls).
    prev?.removeAttribute('hidden');
    next?.removeAttribute('hidden');

    prev?.addEventListener('click', () => scrollToIndex(from() - 1));
    next?.addEventListener('click', () => scrollToIndex(from() + 1));
    dots.forEach((d) =>
      d.addEventListener('click', () => scrollToIndex(Number(d.dataset.index))),
    );

    // Keyboard: left/right move when the gallery (or a control in it) is focused.
    // Any other key may scroll the track itself, so it lets the target go.
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToIndex(from() - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToIndex(from() + 1);
      } else {
        byHand();
      }
    });

    // A track that changes width keeps the picture it was on. Safari keeps the
    // old pixel offset instead, so narrowing past it lands on the last picture
    // (hunt-project 0001; WebKit bug 184774). The jump is instant — a smooth one
    // would glide across every picture in between — and it runs from the scroll
    // handler as well as the observer, because the clamped scroll arrives first
    // and must not be taken as the visitor's own move. Mid-glide it lands on the
    // picture the glide was going to: pinned to `current`, a phone turned just
    // after a dot was pressed stayed where it started (chaos-project 0001).
    let width = track.clientWidth;
    const pin = () => {
      if (track.clientWidth === width) return false;
      width = track.clientWidth;
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = leftOf(from());
      track.style.removeProperty('scroll-behavior');
      return true;
    };
    new ResizeObserver(pin).observe(track);

    // The current slide is the one nearest the middle, so the counter and the
    // dots change at the halfway point of any move — arrow, dot, key, swipe or
    // trackpad — rather than once a slide is 60% in.
    let queued = false;
    track.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (pin()) return;
          const i = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
          if (i !== current) {
            current = i;
            render();
          }
          if (target !== null && Math.abs(track.scrollLeft - leftOf(target)) <= 1) target = null;
        });
      },
      { passive: true },
    );

    render();
  }

  document.querySelectorAll<HTMLElement>('.gallery').forEach(initGallery);
  // The phone rail: arrows page by one view, the count says which shots are in
  // view, and both follow the scroll whether it came from a swipe, a trackpad,
  // an arrow or the keyboard.
  function initPhones(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.phone-track');
    const prev = root.querySelector<HTMLButtonElement>('.nav.prev');
    const next = root.querySelector<HTMLButtonElement>('.nav.next');
    const count = root.querySelector<HTMLElement>('.phone-count');
    const from = root.querySelector<HTMLElement>('.phone-from');
    const to = root.querySelector<HTMLElement>('.phone-to');
    const slides = Array.from(track?.querySelectorAll<HTMLElement>('.phone') ?? []);
    if (!track || !prev || !next || slides.length < 3) return;

    const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
    const perView = () => Math.max(1, Math.round((track.clientWidth + (step() - slides[0].offsetWidth)) / step()));
    const max = () => track.scrollWidth - track.clientWidth;
    // The first shot the last press sent the rail to. A press pages on from
    // there, to a whole shot, rather than by an offset from wherever a glide had
    // got to: that added to a half-way point, so 2 quick taps on Next stopped
    // short of the end and Safari left the rail resting part-way across a shot
    // (chaos-project 0001). Let go on arrival, or when the visitor moves it.
    let target: number | null = null;
    const leftOf = (first: number) => Math.min(first * step(), max());
    const render = () => {
      const first = Math.round(track.scrollLeft / step());
      if (from) from.textContent = String(first + 1);
      if (to) to.textContent = String(Math.min(slides.length, first + perView()));
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max() - 1;
      if (target !== null && Math.abs(track.scrollLeft - leftOf(target)) <= 1) target = null;
    };
    const page = (dir: number) => {
      const start = target ?? Math.round(track.scrollLeft / step());
      target = Math.max(0, Math.min(slides.length - perView(), start + dir * perView()));
      track.scrollTo({ left: leftOf(target) });
      if (Math.abs(track.scrollLeft - leftOf(target)) <= 1) target = null;
    };
    const byHand = () => {
      target = null;
    };
    track.addEventListener('pointerdown', byHand, { passive: true });
    track.addEventListener('touchstart', byHand, { passive: true });
    track.addEventListener('wheel', (e) => e.deltaX && byHand(), { passive: true });

    prev.removeAttribute('hidden');
    next.removeAttribute('hidden');
    count?.removeAttribute('hidden');
    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        page(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        page(1);
      } else {
        byHand();
      }
    });
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        render();
      });
    };
    track.addEventListener('scroll', onScroll, { passive: true });
    // A size change mid-glide re-aims at the same shot, which now sits elsewhere.
    const onResize = () => {
      if (target !== null) track.scrollTo({ left: leftOf(target) });
      onScroll();
    };
    window.addEventListener('resize', onResize);
    // Re-measure whenever the rail's real size settles, not only on a scroll or a
    // window resize. Reached through a page change, Safari can run this script
    // before the stylesheet applies (WebKit bug 261655): the first reading saw
    // nothing to scroll and left Next switched off (smooth-project 0001). The
    // slides change size when the styles land; the track itself may not.
    if ('ResizeObserver' in window) {
      const sizes = new ResizeObserver(onResize);
      sizes.observe(track);
      sizes.observe(slides[0]);
    }
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-phones]').forEach(initPhones);
</script>
