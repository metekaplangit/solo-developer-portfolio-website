---
import type { PrivacyPolicyEntry, MediaAsset } from '../content/schema';
import { formatDate } from '../lib/format';
import ProductAvatar from './ProductAvatar.astro';
import SupportEmail from './SupportEmail.astro';
import {
  policyFacts,
  protectionText,
  childrenText,
  rightsText,
  contactRequestsText,
  changesText,
  resolveSection,
} from '../lib/policy-text';

interface Props {
  policy: PrivacyPolicyEntry;
  /** The product's app icon, shown beside the title. Omitted for the site-wide policy. */
  icon?: MediaAsset | null;
  /** When set, the icon links to the product (e.g. its app detail page). */
  iconHref?: string;
  /** Product name — used for the linked icon's accessible label. */
  iconName?: string;
}
const { policy, icon = null, iconHref, iconName } = Astro.props;

const collectsData = policy.dataCollected.length > 0;
const hasThirdParties = policy.thirdPartyServices.length > 0;

// Section prose comes from `src/lib/policy-text.ts` — the content file's own
// override where it set one, the generated default otherwise (STEP-0067). This
// component decides WHERE text goes and never WHAT it says, so a product whose
// legal wording has to differ changes its own content file rather than a
// component every product renders through.
const facts = policyFacts(policy);
const o = policy.sections;
const text = {
  protection: resolveSection(o.protection, protectionText(facts)),
  children: resolveSection(o.children, childrenText(facts)),
  rights: resolveSection(o.rights, rightsText(facts)),
  contactRequests: resolveSection(o.contactRequests, contactRequestsText()),
  changes: resolveSection(o.changes, changesText(facts)),
};

// At-a-glance chips — the gist in one scan. Each: label + tone.
const chips: { label: string; ok: boolean }[] = [
  { label: collectsData ? 'Minimal data collected' : 'No data collected', ok: !collectsData },
  { label: policy.hasAccounts ? 'Account-based' : 'No account needed', ok: !policy.hasAccounts },
  { label: hasThirdParties ? 'Uses named services' : 'No third-party sharing', ok: !hasThirdParties },
];
---

<article class="policy">
  <header class="policy-head identity">
    {icon && <ProductAvatar icon={icon} name={iconName ?? policy.title} size={56} alt={icon.altText} href={iconHref} />}
    <div class="policy-head-text identity-text">
      <h1 class="page-title">{policy.title}</h1>
      <p class="policy-meta">
        Updated <time datetime={policy.lastUpdated.toISOString()}>{formatDate(policy.lastUpdated)}</time>{' · '}{policy.effectiveScope}
      </p>
    </div>
  </header>

  <ul class="glance" aria-label="At a glance">
    {chips.map((c) => <li class={`chip chip-lg${c.ok ? ' chip-accent' : ''}`}>{c.label}</li>)}
  </ul>

  <div class="policy-lead"><slot /></div>

  <div class="sections row-stack">
    <section class="card">
      <h2 class="card-title">What we collect</h2>
      <div class="sec-body">
      {
        collectsData ? (
          <ul>{policy.dataCollected.map((d) => <li>{d}</li>)}</ul>
        ) : (
          <p class="sec-plain">Nothing. This product doesn't collect personal data.</p>
        )
      }
      </div>
    </section>

    {
      collectsData && (
        <section class="card">
          <h2 class="card-title">How we use it</h2>
          <div class="sec-body">
          {policy.dataUse.length > 0 ? (
            <ul>{policy.dataUse.map((d) => <li>{d}</li>)}</ul>
          ) : (
            <p class="sec-plain">Only as described above — never for advertising, profiling, or tracking.</p>
          )}
          </div>
        </section>
      )
    }

    {
      policy.dataNotCollected.length > 0 && (
        <section class="card">
          <h2 class="card-title">What we never collect</h2>
          <div class="sec-body">
          <ul>{policy.dataNotCollected.map((d) => <li>{d}</li>)}</ul>
          </div>
        </section>
      )
    }

    <section class="card">
      <h2 class="card-title">Third-party sharing</h2>
      <div class="sec-body">
      {
        hasThirdParties ? (
          <>
            <ul>{policy.thirdPartyServices.map((d) => <li>{d}</li>)}</ul>
            <p class="sec-note">
              Any third party that touches this data must protect it the same way this
              policy describes. It is never shared with third-party AI services.
            </p>
          </>
        ) : (
          <p class="sec-plain">
            None. Your data isn't shared with anyone — including third-party AI services.
          </p>
        )
      }
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Keeping &amp; deleting your data</h2>
      <div class="sec-body">
      {
        policy.storedLocally.length > 0 && (
          <>
            <p class="sec-label">Stored only on your device:</p>
            <ul>{policy.storedLocally.map((d) => <li>{d}</li>)}</ul>
          </>
        )
      }
      {/* The retention statement is free prose from the content file and may
          name the support address, so it needs the same edge protection as the
          links below. */}
      <p class="sec-plain"><SupportEmail>{policy.retention}</SupportEmail></p>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">How your data is protected</h2>
      <div class="sec-body">
      <p class="sec-plain">{text.protection}</p>
      </div>
    </section>

    {
      policy.permissions.length > 0 && (
        <section class="card">
          <h2 class="card-title">Permissions</h2>
          <div class="sec-body">
          <ul>{policy.permissions.map((d) => <li>{d}</li>)}</ul>
          </div>
        </section>
      )
    }

    {
      policy.hasAccounts && (
        <section class="card">
          <h2 class="card-title">Your account</h2>
          <div class="sec-body">
          <p class="sec-plain">
            Delete your account and its data from within the app, or email{' '}
            <SupportEmail><a href={`mailto:${policy.contact}`}>{policy.contact}</a></SupportEmail>.
          </p>
          </div>
        </section>
      )
    }

    <section class="card">
      <h2 class="card-title">Children's privacy</h2>
      <div class="sec-body">
      <p class="sec-plain">{text.children}</p>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Your rights</h2>
      <div class="sec-body">
      {/* The address is appended here, not carried in the prose: an override
          must not be able to drop the contact route Apple 5.1.1(i) requires
          this page to offer. */}
      <p class="sec-plain">
        {text.rights}
        <SupportEmail><a href={`mailto:${policy.contact}`}>{policy.contact}</a></SupportEmail>{collectsData ? " and we'll respond." : '.'}
      </p>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Contact &amp; requests</h2>
      <div class="sec-body">
      <p class="sec-plain">
        {text.contactRequests}<SupportEmail><a href={`mailto:${policy.contact}`}>{policy.contact}</a></SupportEmail>.
      </p>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Changes to this policy</h2>
      <div class="sec-body">
      <p class="sec-plain">{text.changes}</p>
      </div>
    </section>
  </div>

  <p class="policy-note">Written in plain language. This is not legal advice.</p>
</article>

<style>
  /* Brought onto the site's band system (STEP-0039). This used to be one
     narrow hairline-divided column with a different rhythm from every other
     page; it now shares the shell width, the band spacing, and the panel
     treatment the rest of the site uses. Prose still gets a real measure —
     the BAND is wide, the TEXT is capped. */
  .policy {
    padding-block: var(--page-top) var(--band-y);
  }
  /* Icon beside the title, not above it (STEP-0061). Shape comes from the
     shared `.identity` lockup in global.css so this header and the product
     detail header cannot drift apart; the icon drops 72px → 56px because at
     56 it clears the title's two-line block without towering over it. The
     rail argument that put this on its own row is answered in `.identity`. */
  /* Fluid rather than a flat `--text-3xl`. Policy titles are the longest
     headings on the site — "MetKap Studio Website Privacy Policy" is 36
     characters — and at a fixed 44px that measured three lines and 139px of
     header on a 390px phone, pushing the at-a-glance chips and the lede down
     the first screen. The cap is the original `--text-3xl`, so desktop is
     unchanged from ~628px up; only phones scale down. */
  /* Size, weight, line-height and tracking come from the shared `.page-title`
     (global.css) so a policy heading is the same size as every other page
     masthead. Only the bottom margin is local: a policy title is immediately
     followed by its dated meta line, which sits tighter than a page lede. */
  .policy-head h1 {
    margin-bottom: var(--space-3);
  }
  .policy-meta {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--faint);
    font-size: var(--text-xs);
  }

  /* At a glance */
  .glance {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
  }
  /* The chip's shape and tones live in `.chip` / `.chip-lg` / `.chip-accent`
     (global.css). Nothing about the pill is defined here any more. */

  /* `--muted`, matching every other page's lede. It was `--text` (near-white)
     at 20px, which made this one paragraph brighter than the body copy on
     every other page — the "text colour not matching the rest of the pages"
     inconsistency. */
  .policy-lead {
    margin-top: var(--space-8);
    max-width: var(--measure-mid);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--muted);
  }
  .policy-lead :global(p) {
    margin: 0;
  }

  /* One block per line, full width, heading rail on the left (STEP-0042).
     These were a 3-column card grid with `align-items: start`, which produced
     visibly ragged heights (measured 127/199/127 in a single row) and made a
     reference document read as a dashboard. A policy is scanned top-to-bottom,
     not compared side-by-side. Cards, grid and type all come from the shared
     `.card` system now. */
  .sections {
    margin-top: var(--band-y);
  }
  .sec-body {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
  }
  .sec-plain {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .sec-label {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .sec-note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--faint);
    line-height: 1.6;
  }
  .sec-body :global(a),
  .sections a {
    color: var(--accent);
  }

  .policy-note {
    margin-top: var(--band-y);
    max-width: var(--measure);
    color: var(--faint);
    font-size: var(--text-sm);
  }
</style>
