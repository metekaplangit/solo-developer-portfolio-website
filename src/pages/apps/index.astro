---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductBand from '../../components/ProductBand.astro';
import { sortProducts } from '../../lib/products';
import { tie } from '../../lib/typography';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';

const entries = await getCollection('products');
const products = sortProducts(entries.map((e) => e.data));

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Apps & Games', path: '/apps/' },
  ]),
  itemListSchema(products),
];
---

<BaseLayout
  title="Apps & Games"
  description="Every app and game from MetKap Studio, newest first. Each has its own privacy page, and you can email us about any of them."
  schema={schema}
  bleed
>
  <section class="masthead" aria-labelledby="catalog-h">
    <div class="rail opening">
      <div class="opening-head">
      <p class="over" data-land="1">{products.length} {products.length === 1 ? 'product' : 'products'}</p>
      <h1 id="catalog-h" class="page-title" data-land="2">Apps &amp; Games</h1>
      </div>
      <div class="opening-side">
      <p class="lede" data-land="3">
        {tie('Everything we’ve released so far, newest first. Each one has its own privacy page, and you can email us about any of them.')}
      </p>
      </div>
    </div>
  </section>

  {/* One band per product, each in its own colour — the same component the home
      page uses. The catalog lead-row that duplicated it is gone (2026-07-18
      health check, follow-up #1). */}
  {
    products.map((p, i) => (
      <section aria-labelledby={`p-${p.slug}`}>
        <ProductBand product={p} index={i + 1} headingId={`p-${p.slug}`} eager={i === 0} />
      </section>
    ))
  }

  <section class="tail">
    <div class="rail">
      <p class="prose">
        {tie('We’re working on more, and it appears here once you can install it.')}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .over {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--faint);
  }
  .masthead {
    padding-block: var(--page-top) var(--band-y-tight);
  }
  .lede {
    margin: 0;
    max-width: var(--measure-mid);
    font-size: var(--text-lede);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .tail {
    padding-block: var(--band-y);
    border-top: 1px solid var(--border);
  }
  .tail p {
    margin: 0;
    max-width: var(--measure-mid);
    color: var(--muted);
    line-height: var(--leading-body);
  }
</style>
