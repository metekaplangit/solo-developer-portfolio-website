---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductBand from '../../components/ProductBand.astro';
import { sortProducts } from '../../lib/products';
import { withBase } from '../../lib/url';
import { tie } from '../../lib/typography';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';

const entries = await getCollection('products');
const products = sortProducts(entries.map((e) => e.data));

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Apps & Games', path: '/apps/' },
  ]),
  itemListSchema(products),
];
---

<BaseLayout
  title="Apps & Games"
  description="Every app and game — released, in beta, and planned — each with privacy and support links."
  schema={schema}
  bleed
>
  <section class="masthead" aria-labelledby="catalog-h">
    <div class="rail">
      <p class="over">{products.length} {products.length === 1 ? 'product' : 'products'}</p>
      <h1 id="catalog-h" class="page-title">Apps &amp; Games</h1>
      <p class="lede">
        {tie('Everything the studio has shipped. Each product has its own privacy page and its own support page — no shared boilerplate.')}
      </p>
    </div>
  </section>

  {/* One band per product, each in its own colour — the same component the home
      page uses. The catalog lead-row that duplicated it is gone (2026-07-18
      health check, follow-up #1). */}
  {
    products.map((p, i) => (
      <section aria-labelledby={`p-${p.slug}`}>
        <ProductBand product={p} index={i + 1} headingId={`p-${p.slug}`} eager={i === 0} />
      </section>
    ))
  }

  <section class="tail">
    <div class="rail">
      <p class="prose">
        {tie('More is in progress. Nothing gets announced here until it’s ready to install — ')}<a
          href={withBase('/support/')}>get in touch</a>{tie(' if you want to hear when it is.')}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .over {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .masthead {
    padding-block: var(--page-top) var(--band-y-tight);
  }
  .lede {
    margin: 0;
    max-width: var(--measure-mid);
    font-size: var(--text-lede);
    line-height: 1.6;
    color: var(--muted);
  }
  .tail {
    padding-block: var(--band-y);
    border-top: 1px solid var(--border);
  }
  .tail p {
    margin: 0;
    max-width: var(--measure-mid);
    color: var(--muted);
    line-height: 1.7;
  }
</style>
