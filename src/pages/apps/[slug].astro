---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import ProductAvatar from '../../components/ProductAvatar.astro';
import {
  visibleStoreLinks,
  hasStoreLinks,
  productHue,
  storeLabel,
  statusLabel,
  platformLabel,
  relatedProducts,
  productSummary,
} from '../../lib/products';
import { canonicalPrivacyUrl } from '../../lib/privacy';
import { formatDate } from '../../lib/format';
import { withBase } from '../../lib/url';
import { softwareApplicationSchema, breadcrumbSchema } from '../../lib/schema';
import { resolveScreenshot, screenshotTitle } from '../../lib/screenshots';
import ScreenshotShowcase from '../../components/ScreenshotShowcase.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import FactsLine from '../../components/FactsLine.astro';
import FitStatement from '../../components/FitStatement.astro';
import MakerNote from '../../components/MakerNote.astro';
import ProductTile from '../../components/ProductTile.astro';
import { evenColumns } from '../../lib/grid';
import { tie } from '../../lib/typography';

export async function getStaticPaths() {
  const entries = await getCollection('products');
  const all = entries.map((e) => e.data);
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, related: relatedProducts(all, entry.data) },
  }));
}

interface Props {
  entry: CollectionEntry<'products'>;
  related: Array<CollectionEntry<'products'>['data']>;
}
const { entry, related } = Astro.props;
const product = entry.data;
const { Content } = await render(entry);

const stores = visibleStoreLinks(product);

// The same two facts FactsLine states, as values for the opening's spec sheet.
const price = product.price === '0' ? 'Free' : product.price != null ? `$${product.price} (one-time)` : null;

// Resolve content screenshots to build-time-optimized image assets (astro:assets).
const shots = product.screenshots
  .map((s) => ({ img: resolveScreenshot(s.path), alt: s.altText, title: screenshotTitle(s.path) }))
  .filter((s): s is { img: NonNullable<typeof s.img>; alt: string; title: string } =>
    Boolean(s.img),
  );

const seoTitle = product.seo?.title ?? product.name;
const seoDescription = product.seo?.description ?? product.summary;

const schema = [
  softwareApplicationSchema(product, seoDescription),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Apps & Games', path: '/apps/' },
    { name: product.name, path: `/apps/${product.slug}/` },
  ]),
];
---

<BaseLayout title={seoTitle} description={seoDescription} schema={schema}>
  {/* A product's own page IS that product's band, in full — so the page speaks
      in its colour rather than the studio's. Remapping the four accent tokens
      here (instead of touching each component) means the download button, the
      badges, the gallery controls and the focus ring all pick up the product's
      hue with no component knowing anything about hues. One Voice Per Band,
      DESIGN.md §2. */}
  <div class="product-page" style={`--hue: ${productHue(product)};`}>
  <nav class="band page-back" aria-label="Breadcrumb">
    <a href={withBase('/apps/')}>← Apps &amp; Games</a>
  </nav>

  <!-- Header band: identity and the primary action, nothing else.
       One lockup, not three stacked blocks (STEP-0061). The icon, the name and
       the chips that qualify the name are one unit on one line; the summary
       and the action row follow it. What changed is the ORDER as much as the
       geometry — the chips used to sit above the name, so the first thing read
       on a product page was "App · Released · macOS" rather than the product. -->
  <section class="band detail-head" aria-labelledby="product-h">
    <div class="identity">
      {/* 56, not 72 (STEP-0081). The lockup pushes the page title in by the
          icon's width plus the gap, so an icon size is also a title indent:
          72 here against 56 on the policy header put the same kind of heading
          88px and 72px off the shared rail, two answers with only one of them
          written down. 56 is the size the band and the policy header already
          use, and it is the one the policy header has a recorded reason for.

          Measured at the top of the first screen on every width — 165px down at
          390px, 153px at 1440px — so it is never lazy. */}
      <ProductAvatar icon={product.icon} name={product.name} size={56} eager />
      <div class="identity-text head-body">
        <h1 id="product-h" class="product-title product-name">{product.name}</h1>
        <div class="tags">
          <Badge label={product.type === 'game' ? 'Game' : 'App'} tone="accent" />
          <Badge label={statusLabel(product.status)} />
          {product.platforms.map((p) => <Badge label={platformLabel(p)} tone="muted" />)}
        </div>
      </div>
    </div>

    <p class="summary measure-mid">{productSummary(product)}</p>

    <div class="action-row">
      <DownloadButton product={product} />
      <a class="btn btn-secondary" href={withBase(canonicalPrivacyUrl(product))}>Privacy details</a>
    </div>

    {/* The decision facts and the person behind them, as a ruled sheet on the
        right of the opening rather than two faint lines under the buttons. It
        fills the top-right of the first screen, which stood empty beside the
        lockup, with what a visitor checks before clicking through. */}
    <dl class="spec">
      {price && (
        <div class="spec-row">
          <dt>Price</dt>
          <dd>{price}</dd>
        </div>
      )}
      {product.requirements && (
        <div class="spec-row">
          <dt>Requires</dt>
          <dd>{tie(product.requirements)}</dd>
        </div>
      )}
      <div class="spec-row">
        <dt>Made by</dt>
        <dd><a href={withBase('/about/')}>Mete Kaplan</a></dd>
      </div>
      <div class="spec-row">
        <dt>Support</dt>
        <dd><a href={withBase('/support/')}>{tie('Usually within 2–3 business days')}</a></dd>
      </div>
    </dl>
  </section>

  {/* `band`, not `band-loose`. Loose means "a new argument starts here", and
      the gallery is not one — it shows the product the header just named. With
      loose it opened 120px below the trust line and closed 80px above the
      panels, the widest gap on the page and lopsided with it. */}
  <div class="band gallery-band">
    <ScreenshotShowcase shots={shots} label={`${product.name} screenshots`} />
  </div>

  <!-- Who it's for, before the feature list. -->
  <section class="band band-tight fit-band">
    <FitStatement product={product} />
  </section>

  {
    product.features.length > 0 && (
      <section class="band band-loose features-band" aria-labelledby="features-h">
        {/* A ruled list, not a wall of boxes: twelve identical cards was the
            "endless identical feature cards" DESIGN.md names as the thing to
            avoid. The heading takes the left rail the policy rows use, and each
            claim is a numbered line in the product's hue — the same index the
            home page gives its three statements. */}
        <div class="features">
          <h2 id="features-h" class="band-title features-title">What it does</h2>
          <ol
            class="feature-list grid-even"
            role="list"
            style={`--cols-mid: ${evenColumns(product.features.length, 2)}; --cols-wide: ${evenColumns(product.features.length, 3)};`}
          >
            {product.features.map((f, i) => (
              <li class="feature">
                <span class="feature-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {/* A compound never splits at its hyphen ("exchange- / rate"):
                    the hyphen becomes a non-breaking one for display only. */}
                <span class="feature-text">{f.replace(/(\w)-(\w)/g, '$1‑$2')}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- The description prose, capped at a real measure so it stops running the
       full shell width. This is the band that used to feel most cramped.
       Deliberately a plain `div`, not a labelled `section`: a named section is
       a `region` landmark, and MakerNote's `<aside>` (a `complementary`
       landmark) nested inside one trips axe's
       `landmark-complementary-is-top-level`. -->
  <div class="band band-loose prose-band">
    {/* The story keeps the page's one grid: section names on the label rail
        "What it does" opened, the prose on the column its list runs in. It was
        one 560px column with the right 45% of the rail empty for ~2000px on
        the two products with no maker note. The maker's note, where there is
        one, opens the column as its first voice. */}
    <div class="story">
      {product.makerNote.length > 0 && (
        <div class="story-note">
          <MakerNote product={product} />
        </div>
      )}
      <div class="prose story-prose">
        <Content />
      </div>
    </div>
  </div>

  <section class="band band-loose band-tail get-band" aria-labelledby="get-h">
    {/* One surface for everything a visitor needs at the end of the page: the
        product, the store, and the dates and links that back them. The dates
        used to sit loose under the panel, 30px from its edge, reading as a
        second, unrelated block. */}
    <div class="panel panel-accent get reveal">
      <div class="get-main">
        <div class="identity get-id">
          <ProductAvatar icon={product.icon} name={product.name} size={56} />
          <div class="identity-text">
            <h2 id="get-h" class="get-title">Get {product.name}</h2>
            <FactsLine product={product} />
          </div>
        </div>
        {
          hasStoreLinks(product) ? (
            <div class="get-actions">
              {stores.map((link, i) =>
                i === 0 && link.status === 'available' ? (
                  <DownloadButton product={product} />
                ) : (
                  <a class="btn btn-secondary" href={link.url} rel="noopener" target="_blank">
                    {storeLabel(link.store)}
                    {link.status === 'coming-soon' ? ' (soon)' : ''}
                  </a>
                ),
              )}
            </div>
          ) : (
            <p class="unreleased">Not yet available — check back soon.</p>
          )
        }
      </div>

    {/* Each dt/dd wrapped in a div: as bare grid items they became four equal
        273px tracks with labels and values alternating HORIZONTALLY, so a
        label never sat above its own value. The `dd { margin-top }` below
        proves the intent was label-over-value; it could never fire. */}
    <dl class="meta">
      {
        product.releaseDate && (
          <div class="meta-pair">
            <dt>Released</dt>
            <dd>{formatDate(product.releaseDate)}</dd>
          </div>
        )
      }
      {
        product.lastUpdated && (
          <div class="meta-pair">
            <dt>Last updated</dt>
            <dd>{formatDate(product.lastUpdated)}</dd>
          </div>
        )
      }
      <div class="meta-pair">
        <dt>Privacy &amp; support</dt>
        <dd>
          <a href={withBase(canonicalPrivacyUrl(product))}>Privacy policy</a>{' · '}<a href={withBase(product.supportUrl)}>Support</a>
        </dd>
      </div>
    </dl>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-h">
          <h2 id="related-h" class="band-title">More {product.type === 'game' ? 'games' : 'apps'}</h2>
          {/* The shared product tile — icon, name, what it is — so a sibling
              product is recognised by its icon, as it is everywhere else. */}
          <ul
            class="tile-grid grid-even"
            role="list"
            style={`--cols-mid: ${evenColumns(related.length, 2)}; --cols-wide: ${evenColumns(related.length, 3)};`}
          >
            {related.map((r) => (
              <li>
                <ProductTile product={r} href={`/apps/${r.slug}/`} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>
  </div>
</BaseLayout>

<style>
  /* The whole page is this product's band. */
  .product-page {
    --accent: var(--hue);
    --accent-hover: var(--hue);
    --accent-soft: var(--hue-soft);
    --accent-contrast: var(--hue-contrast);
    --accent-glow: var(--hue-wash);
  }

  /* Placement and colour for the back link come from the shared `.page-back`
     rule in global.css — the same rule the policy page uses, so the two cannot
     drift. Nothing local is left. */

  /* Header — icon beside identity. No panel: the page's first band should feel
     open, not boxed. The old header put the icon, name, badges, summary, CTA,
     facts and trust line inside one 43rem card, which is what read as cramped. */
  .detail-head {
    margin-top: var(--space-4);
  }
  /* Layout comes from the shared `.identity` lockup. Only the gap below it is
     local: the summary is a continuation of the identity, not a new idea. */
  .head-body {
    min-width: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .product-name {
    margin: 0 0 var(--space-3);
    /* Clamped, and allowed to break: `--text-3xl` is a flat 2.75rem, so an
       unbreakable long name at 44px overflowed a 149px track. */
    /* Size, weight, line-height and tracking come from the global
       `.product-title`; only the wrapping guard is local. */
    overflow-wrap: anywhere;
    font-weight: var(--weight-display);
    letter-spacing: var(--track-optical);
    line-height: var(--leading-display);
  }
  .summary {
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }
  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  /* The opening: lockup, summary and actions on the left; the spec sheet on
     the right, its last rule level with the bottom of the buttons. */
  @media (min-width: 64rem) {
    .detail-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      column-gap: var(--gutter);
      align-items: end;
    }
    .detail-head > :not(.spec) {
      grid-column: 1;
    }
    .detail-head > .spec {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
  /* A ledger: one fact per ruled row, the label left and the value right,
     closed by a last rule so the sheet reads as one object. */
  .spec {
    margin: var(--space-8) 0 0;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 64rem) {
    .spec {
      margin: 0;
    }
  }
  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-width: 0;
    padding-block: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .spec dt {
    flex: none;
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }
  .spec dd {
    margin: 0;
    min-width: 0;
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    text-align: right;
  }
  .spec dd a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .spec dd a:hover {
    color: var(--text-strong);
    text-decoration-color: currentColor;
  }

  /* What it does — a ruled, numbered list. The track COUNT still comes from
     `.grid-even` and the `--cols-*` values (the full-row rule, STEP-0063), so
     every column ends on the same line. One cue only: a hairline above each
     claim, no fill. */
  .features {
    display: grid;
    gap: var(--space-2) var(--gutter);
  }
  @media (min-width: 64rem) {
    .features {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      align-items: start;
    }
  }
  .features-title {
    margin: 0;
    padding-top: var(--space-5);
  }
  .feature-list {
    column-gap: var(--space-8);
    row-gap: 0;
    counter-reset: none;
  }
  .feature {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .feature-n {
    color: var(--hue);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
  }
  .feature-text {
    color: var(--text);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    /* Balance, not pretty: each claim is a caption of two or three lines,
       and `pretty` only rescues the last one — measured, item 07 broke as
       "chosen / by you rather / than by your region" at 1440. */
    text-wrap: balance;
  }

  /* The story — label rail left, prose right, the same two tracks and gap as
     `.features` above, so the prose starts on the line the feature list does
     and every section opens on one hairline across both tracks. */
  .story-prose > :global(*) {
    margin: var(--space-4) 0 0;
    min-width: 0;
  }
  .story-prose > :global(:first-child) {
    margin-top: 0;
  }
  /* The opening paragraph reads as the story's lede. */
  .story-prose > :global(p:first-child) {
    color: var(--text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }
  .story-prose > :global(h2) {
    margin: var(--space-12) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    text-wrap: balance;
  }
  @media (min-width: 64rem) {
    .story-prose {
      display: grid;
      grid-template-columns: minmax(0, 15rem) minmax(0, var(--measure-mid));
      column-gap: var(--gutter);
      align-items: start;
    }
    .story-prose > :global(*) {
      grid-column: 2;
    }
    /* A heading spans the rows of its section (no section runs past six
       blocks), so a three-line heading never pushes its own second paragraph
       down: the rows it does not fill are empty and collapse to nothing. */
    .story-prose > :global(h2) {
      grid-column: 1;
      grid-row: span 6;
    }
    /* The section's first paragraph shares the heading's row, rule and air. */
    .story-prose > :global(h2 + *),
    .story-prose.prose :global(#common-questions + p:has(> strong:first-child)) {
      margin-top: var(--space-12);
      padding-top: var(--space-5);
      border-top: 1px solid var(--border);
    }
    /* A story that opens on a heading starts both tracks on the top line. */
    .story-prose > :global(h2:first-child + *) {
      margin-top: 0;
    }
    /* The maker's note takes the same two tracks: its label on the rail,
       its words in the column. */
    .story-note {
      margin-bottom: var(--space-12);
    }
    .story-note :global(.maker-note) {
      display: grid;
      grid-template-columns: minmax(0, 15rem) minmax(0, var(--measure-mid));
      column-gap: var(--gutter);
      align-items: baseline;
      max-width: none;
      /* Space, not a full-width rule: every rule in the story is the
         two-segment section rule, and this one ran straight across both. */
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: 0;
    }
    .story-note :global(.maker-heading) {
      margin: 0;
    }
  }
  @media (max-width: 63.999rem) {
    .story-note {
      margin-bottom: var(--space-10);
    }
  }

  .prose :global(p) {
    color: var(--muted);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
  .prose :global(h2) {
    font-size: var(--text-xl);
    letter-spacing: var(--track-optical);
    line-height: var(--leading-heading);
  }
  /* Waypost Words lists its seven skills in its description. */
  .prose :global(ul) {
    padding-inline-start: 1.25rem;
    color: var(--muted);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(strong) {
    color: var(--text-strong);
    font-weight: var(--weight-strong);
  }

  /* Common questions — each question on its own line over its answer, the
     pairs ruled apart with the same hairline the feature list uses. The
     Markdown stays one bold lead per paragraph; only the presentation knows
     these are questions, so no content file changes. */
  .prose :global(#common-questions) {
    margin-bottom: var(--space-6);
  }
  .prose :global(#common-questions ~ p:has(> strong:first-child)) {
    margin: 0;
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .prose :global(#common-questions ~ p:has(> strong:first-child):not(:has(+ p > strong:first-child))) {
    border-bottom: 1px solid var(--border);
  }
  .prose :global(#common-questions ~ p > strong:first-child) {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-optical);
    line-height: var(--leading-ui);
  }
  .prose :global(#common-questions ~ p:has(> em:only-child)) {
    margin-top: var(--space-6);
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .get {
    padding: 0;
    overflow: hidden;
  }
  .get-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: clamp(var(--space-6), 3.5vw, var(--space-10));
  }
  .get-id {
    align-items: center;
  }
  .get-id > :global(.avatar) {
    margin-top: 0;
  }
  /* Fluid so "Get <name>" stays one line beside the icon on a phone. */
  .get-title {
    margin: 0;
    font-size: clamp(var(--text-xl), 5.5vw, var(--text-2xl));
    letter-spacing: var(--track-optical);
  }
  .get-id :global(.facts-line) {
    margin-top: var(--space-2);
  }
  .get-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .unreleased {
    margin: 0;
    color: var(--muted);
  }

  /* The panel's footer: a hairline, then the three facts in a row, on a
     slightly deeper tone so they read as the panel's small print. */
  .meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-5) var(--space-8);
    padding: var(--space-5) clamp(var(--space-6), 3.5vw, var(--space-10));
    border-top: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.18);
    font-size: var(--text-sm);
  }
  .meta-pair {
    min-width: 0;
  }
  .meta dt {
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }
  .meta dd {
    margin: var(--space-1) 0 0;
    color: var(--text);
  }
  .meta dd a {
    color: var(--text);
  }
  .meta dd a:hover {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related {
    margin-top: var(--band-y);
  }
</style>
