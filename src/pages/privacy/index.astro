---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyArticle from '../../components/PolicyArticle.astro';
import ProductTile from '../../components/ProductTile.astro';
import { evenColumns } from '../../lib/grid';
import { formatDate } from '../../lib/format';
import { tie } from '../../lib/typography';
import { GLOBAL_POLICY_ID, productPolicyEntries } from '../../lib/privacy';
import { sortProducts } from '../../lib/products';

const entries = await getCollection('policies');
const globalEntry = entries.find((e) => e.data.productId === GLOBAL_POLICY_ID);
const perProduct = productPolicyEntries(entries);

if (!globalEntry) {
  throw new Error('A global privacy policy (productId: global) is required.');
}
const { Content } = await render(globalEntry);

// In the site's one product order — newest release first — like every other
// list of products (owner, 2026-10-29), not by policy title.
const products = sortProducts((await getCollection('products')).map((p) => p.data));
const policies = products.flatMap((product) => {
  const entry = perProduct.find((e) => e.data.productId === product.id);
  return entry ? [{ entry, product }] : [];
});
---

<BaseLayout
  title="Website Privacy Policy"
  description="Privacy policy for the MetKap Studio website (metkapstudio.com). Apps and games each have their own policy, listed here."
>
  <PolicyArticle policy={globalEntry.data} eyebrow="Privacy">
    <Content />
  </PolicyArticle>

  <section class="band band-loose band-tail per-product" aria-labelledby="per-product-h">
    <h2 id="per-product-h" class="band-title">App &amp; game privacy policies</h2>
    <p class="per-product-lead measure">
      {tie('These are separate from the website policy above. Each one says what that app or game keeps on your device — open a policy for the details.')}
    </p>
    {/* One tile per product, recognised by its icon, with the date the policy
        was last revised as the line under the name. Columns from the count,
        so three policies are one full row rather than two and a hole. */}
    <ul
      class="tile-grid grid-even"
      role="list"
      style={`--cols-mid: ${evenColumns(policies.length, 2)}; --cols-wide: ${evenColumns(policies.length, 3)};`}
    >
      {
        policies.map(({ entry, product }) => (
          <li class="reveal">
            <ProductTile
              product={product}
              href={`/privacy/${entry.data.productId}/`}
              hint="privacy policy"
              line={`Privacy policy · updated ${formatDate(entry.data.lastUpdated).replace(/ /g, ' ')}`}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .per-product-lead {
    margin: 0 0 var(--space-6);
    color: var(--muted);
  }
  /* Every tile stretches to the tallest in its row. */
  .tile-grid > li {
    display: grid;
  }
</style>
