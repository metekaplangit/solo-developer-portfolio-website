---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductBand from '../components/ProductBand.astro';
import DownloadButton from '../components/DownloadButton.astro';
import MakerNote from '../components/MakerNote.astro';
import SupportEmail from '../components/SupportEmail.astro';
import { site } from '../lib/site';
import {
  getFeatured,
  sortProducts,
  visibleStoreLinks,
  productHue,
} from '../lib/products';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { resolveScreenshot, screenshotTitle } from '../lib/screenshots';
import { bodySections, firstSentence } from '../lib/prose';

const entries = await getCollection('products');
const products = entries.map((e) => e.data);
const featured = getFeatured(products);
const showcase = featured.length > 0 ? featured : sortProducts(products).slice(0, 3);

const spotlight = showcase[0];
const spotlightEntry = spotlight ? entries.find((e) => e.data.id === spotlight.id) : undefined;
const rest = showcase.slice(1);

const shots = spotlight?.screenshots ?? [];
const mosaic = shots.slice(1);

const heroHasDownload =
  spotlight != null && visibleStoreLinks(spotlight).some((l) => l.status === 'available');

/* "Featured" only means something when there is a set to be featured FROM.
   With a single product the catalog scaffolding advertises the emptiness
   instead of the product, so it stays off until a second product exists. */
const hasCatalog = products.length > 1;

/* One Voice Per Band (DESIGN.md §2): a hue belongs to a product and stays in
   that product's band. The hero is an exception with a stated condition — when
   exactly ONE product is featured, the whole page IS that product's band, so
   the hero may carry its colour. The moment a second product is featured the
   hero goes achromatic again, because the colour would no longer belong to
   anything in particular. */
const heroOwnsHue = featured.length === 1 && spotlight != null;

// Three statements from the product's own approved prose — the FAQ is a
// different surface and the closing sign-off is not body copy.
//
// Opening sentence only (STEP-0062). The full sections run 7, 7 and 4 lines,
// so side by side the third column stopped 74px short of the other two. The
// sections stay long where length belongs — the product page — and the three
// opening sentences are written to a matching length, so these columns are
// three lines each and end level. Truncating with an ellipsis would have
// matched the heights too, and read as a page that ran out of room.
const statements = spotlightEntry
  ? bodySections(spotlightEntry.body ?? '', ['Common questions'])
      .slice(0, 3)
      .map((s) => ({ ...s, text: firstSentence(s.text) }))
  : [];

const makerLines = spotlight?.makerNote ?? [];
const hue = spotlight ? productHue(spotlight) : undefined;
---

<BaseLayout
  title={site.name}
  description={site.description}
  schema={[organizationSchema(), websiteSchema()]}
  bleed
>
  <!-- BAND 1 — the studio, poster scale -->
  <section class={`band-hero${heroOwnsHue ? ' owns-hue' : ''}`} style={heroOwnsHue ? `--hue: ${hue};` : undefined} aria-labelledby="hero-h">
    <div class="rail">
      <p class="over">{site.tagline}</p>
      <h1 id="hero-h">Small studio.<br /><span class="voice">Serious craft.</span></h1>
      <p class="lede">{site.lede}</p>
      <div class="actions">
        {heroHasDownload && <DownloadButton product={spotlight} label="Mac App Store" />}
        <a class={`btn btn-lg ${heroHasDownload ? 'btn-secondary' : 'btn-primary'}`} href="#product">
          See the app
        </a>
      </div>
    </div>
    {heroOwnsHue && <div class="hero-glow" aria-hidden="true"></div>}
  </section>

  <!-- BAND 2 — the product owns this band, in its own colour -->
  {
    spotlight && (
      <section id="product" aria-labelledby="product-h">
        <ProductBand product={spotlight} headingId="product-h" eager announceBakedInText />
      </section>
    )
  }

  <!-- BAND 3 — three statements, in the product's own approved words -->
  {
    statements.length > 0 && (
      <section class="band-says" style={`--hue: ${hue};`} aria-labelledby="says-h">
        <div class="rail says-in">
          <h2 id="says-h" class="visually-hidden">What {spotlight?.name} does</h2>
          {statements.map((s, i) => (
            <article>
              <p class="over voice">{String(i + 1).padStart(2, '0')}</p>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- BAND 4 — the rest of the real screenshots -->
  {
    mosaic.length > 0 && (
      <section class="band-mosaic" aria-labelledby="mosaic-h">
        <div class="rail mosaic-in">
          <h2 id="mosaic-h" class="visually-hidden">More of {spotlight?.name}</h2>
          {mosaic.map((s) => {
            const img = resolveScreenshot(s.path);
            return img ? (
              <figure class="reveal">
                {/* `sizes` measured against the real slot, not guessed: the
                    mosaic is a two-column grid inside the 86rem rail, so the
                    cell is ~42vw once the gap and the gutter are taken out —
                    the previous `40vw` under-declared it (576px against a
                    604px slot at 1440), which made the browser choose a
                    variant one step too small. The 1400w step covers the same
                    slot at DPR 2 on the Retina Macs this audience uses; it
                    changes nothing at DPR 1. */}
                <Image
                  src={img}
                  alt={s.altText}
                  widths={[500, 800, 1200, 1400]}
                  sizes="(min-width: 60rem) 42vw, calc(100vw - 2 * 1.25rem)"
                  format="webp"
                  quality={78}
                  loading="lazy"
                />
                <figcaption>{screenshotTitle(s.path)}</figcaption>
              </figure>
            ) : null;
          })}
        </div>
      </section>
    )
  }

  {
    hasCatalog && rest.length > 0 && (
      <section class="band-catalog" aria-labelledby="catalog-h">
        <div class="rail">
          <h2 id="catalog-h" class="band-title">The catalog</h2>
          <ul class="card-grid" role="list">
            {rest.map((p) => (
              <li class="reveal">
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- BAND 5 — the deal, stated as checkable facts -->
  <section class="band-promise" aria-labelledby="promise-h">
    <div class="rail">
      <h2 id="promise-h" class="over">The deal</h2>
      <ul role="list">
        <li>Free. No in-app purchases, no subscription.</li>
        <li>Offline. No account, no cloud, no tracking.</li>
        <li>Answered. A real person reads <SupportEmail>{site.supportEmail}</SupportEmail>.</li>
      </ul>
    </div>
  </section>

  {
    makerLines.length > 0 && spotlight && (
      <section class="band-maker">
        <div class="rail">
          <MakerNote product={spotlight} tone="quiet" headingId="maker-h" />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Bands ------------------------------------------------------------------
     Each band owns its own vertical air and runs edge to edge; `.rail` inside
     it carries the one shared horizontal measure. Nothing here sets a
     page-level max-width, so every band's left edge is the nav brand's. */
  .over {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .voice {
    color: var(--hue);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  /* BAND 1 — hero */
  /* No `min-height`, and no vertical centring (STEP-0060). The hero used to be
     `min-height: min(82vh, 900px)` with `align-items: center`, which at 1440
     made the band 738px tall around 590px of content — so 74px of nothing was
     inserted ABOVE the eyebrow and another 74px BELOW the buttons, purely to
     centre the block. Those are the two bands the owner boxed in red. The hero
     is now exactly its content plus the shared page-top and one band gap, and
     it starts at the same distance from the header as every other page. Poster
     scale is carried by `--display-1`, which is untouched — it was never the
     height that made this a poster. */
  .band-hero {
    position: relative;
    display: flex;
    padding-block: var(--page-top) var(--band-y);
    overflow: hidden;
  }
  .band-hero h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--display-1);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: var(--text-strong);
  }
  .lede {
    margin: 0 0 var(--space-8);
    max-width: var(--measure-mid);
    font-size: var(--text-lede);
    line-height: 1.55;
    color: var(--muted);
  }
  /* The single wash on the page that belongs to the featured product. Sized in
     % of the band rather than vw so it cannot widen the document. */
  .hero-glow {
    position: absolute;
    inset: auto 0 -45% 15%;
    height: 70%;
    background: radial-gradient(closest-side, var(--hue-wash), transparent 72%);
    pointer-events: none;
  }

  /* BAND 3 — statements */
  .band-says {
    padding-block: var(--band-y);
  }
  .says-in {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: clamp(var(--space-8), 4vw, var(--space-12));
    align-items: start;
  }
  .says-in h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .says-in article p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* BAND 4 — mosaic */
  .band-mosaic {
    padding-bottom: var(--band-y);
  }
  .mosaic-in {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    gap: var(--space-6);
  }
  .mosaic-in figure {
    margin: 0;
  }
  .mosaic-in img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .mosaic-in figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* Catalog (dormant until a second product exists) */
  .band-catalog {
    padding-bottom: var(--band-y);
  }

  /* BAND 5 — the deal */
  .band-promise {
    padding-block: var(--band-y);
    border-top: 1px solid var(--border);
  }
  .band-promise ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .band-promise li {
    font-size: clamp(1.375rem, 3.2vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.2;
    color: var(--text-strong);
    text-wrap: balance;
  }
  .band-promise li + li {
    color: var(--muted);
  }

  .band-maker {
    padding-bottom: var(--band-y-tight);
  }

  @media (max-width: 66rem) {
    .product-in {
      grid-template-columns: 1fr;
    }
    /* (The `min-height: 0` override is gone with the `min-height` it undid.) */
  }

  /* Hero entrance. It used to animate `transform` only, so the text appeared at
     full strength and then moved — which reads as a jolt rather than an
     arrival. Opacity and transform together, on the entrance role, with the
     four children declared in reading order rather than three of them delayed
     and the fourth left implicit. */
  @media (prefers-reduced-motion: no-preference) {
    .band-hero > .rail > * {
      animation: rise var(--dur-slow) var(--ease-out) both;
    }
    /* The delays MUST match the wildcard rule's shape. Measured 2026-07-31:
       written as `.band-hero h1` they lost to `.band-hero > .rail > *` on
       specificity — three classes beat two — so every child computed a 0s
       delay and the whole stagger had silently never run. Selecting through
       the same path keeps them equal, and later-wins does the rest. */
    .band-hero > .rail > .over {
      animation-delay: 0s;
    }
    .band-hero > .rail > h1 {
      animation-delay: 60ms;
    }
    .band-hero > .rail > .lede {
      animation-delay: 120ms;
    }
    .band-hero > .rail > .actions {
      animation-delay: 180ms;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
