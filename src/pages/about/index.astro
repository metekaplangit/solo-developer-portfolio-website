---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';
import { withBase } from '../../lib/url';
import SupportEmail from '../../components/SupportEmail.astro';
import { tie } from '../../lib/typography';

/* Values — how the studio works, not what it promises never to do. Two of these
   said something different until 2026-09-10: "Offline and fast" promised that
   software would not need a network, and "No dark patterns" opened with "No ads,
   no tracking, no engagement traps". Both were commitments about advertising and
   networking, and the studio keeps those decisions open, so both were rewritten
   to the thing underneath them that does not change. Nothing here is a claim
   about a product's business model; what a given app does with data is on that
   app's own privacy page. */
const values = [
  {
    title: 'Privacy first',
    body:
      'Collect as little as possible, and say so plainly, on a privacy page for each product in words you can actually read.',
  },
  {
    title: 'Quick to hand',
    body:
      'Open it and it is ready. Software should not make you wait to do the one thing you opened it for.',
  },
  {
    title: 'No dark patterns',
    body:
      'Nothing on screen is trying to trick you. No guilt streaks, no manufactured urgency, no interface that hides the way out.',
  },
  {
    title: 'A real person answers',
    body:
      'Support email comes straight to me. I read every message, and I usually reply within 2–3 business days.',
  },
].map((v) => ({ ...v, body: tie(v.body) }));
---

<BaseLayout
  title="About"
  description="About MetKap Studio and the developer behind these apps and games."
>
  {/* The headline and the person beside it: the statement on the left, the
      plain introduction on the right, so the opening fills its rail instead of
      leaving the right half of the first screen empty. */}
  <section class="band band-lead about-hero" aria-labelledby="about-h">
    <div class="about-head">
      <p class="eyebrow" data-land="1">About the studio</p>
      <h1 id="about-h" class="page-title about-title" data-land="2">I make software that behaves.</h1>
    </div>
    <p class="lede about-lede" data-land="3">
      {tie(`I’m ${site.person.replace(/ /g, '\u00a0')}, and MetKap Studio is just me. I make small apps and games, and I answer every email about them myself.`)}
    </p>
  </section>

  {/* Four principles as a numbered, ruled list on the label rail — the shape
      the product pages give "What it does" — not four identical boxes. */}
  <section class="band values-band" aria-labelledby="values-h">
    <div class="values-wrap">
      <h2 id="values-h" class="band-title values-title">How I build</h2>
      <ol class="values grid-even" role="list" style="--cols-mid: 2; --cols-wide: 2;">
        {
          values.map((v, n) => (
            <li class="value">
              <span class="value-n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <h3 class="value-title">{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-tail contact-band" aria-labelledby="contact-h">
    <div class="panel contact reveal">
      <div class="contact-copy">
        <h2 id="contact-h" class="contact-title">Get in touch</h2>
        <p>A bug, a question, an idea: write to me.</p>
        {/* The small links live inside the panel they belong to, in the
            site's own type: mono is for code, and these are not code. */}
        <ul class="elsewhere" role="list">
          <li><SupportEmail><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></SupportEmail></li>
          <li><a href={withBase('/apps/')}>Apps &amp; Games</a></li>
          <li><a href={withBase('/privacy/')}>Privacy</a></li>
        </ul>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href={withBase('/support/')}>Contact support</a>
        {
          site.social.map((s) => (
            <a class="btn btn-secondary" href={s.url} rel="me noopener" target="_blank">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* One grid for the page: the label rail, then the two columns of the
     principles. The statement spans the rail and the first column; the
     introduction takes the second, so it starts on the same line as
     principles 02 and 04 below it, and on the page-top line with the eyebrow. */
  @media (min-width: 64rem) {
    .about-hero,
    .values-wrap {
      display: grid;
      grid-template-columns:
        minmax(0, 15rem) var(--gutter) minmax(0, 1fr) var(--space-8) minmax(0, 1fr);
      column-gap: 0;
      align-items: start;
    }
    .about-head {
      grid-column: 1 / 4;
    }
    .about-lede {
      grid-column: 5;
      padding-top: 0.15em;
    }
    .values-title {
      grid-column: 1;
    }
    .values {
      grid-column: 3 / 6;
    }
  }
  .about-title {
    /* Size, weight, line-height and tracking come from `.page-title`; only the
       measure is page-specific. */
    max-width: 18ch;
    margin-bottom: 0;
  }
  @media (max-width: 63.999rem) {
    .about-title {
      max-width: 22ch;
      margin-bottom: var(--space-6);
    }
  }
  .lede {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  /* How I build — the label rail and ruled, numbered rows. */
  @media (min-width: 64rem) {
    .values-title {
      margin: 0;
      padding-top: var(--space-5);
    }
  }
  .values {
    column-gap: var(--space-8);
    row-gap: 0;
  }
  .value {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: var(--space-2);
    align-content: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .value-n {
    grid-row: 1 / span 2;
    padding-top: 0.2em;
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
  }
  .value-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-optical);
    color: var(--text-strong);
  }
  .value p {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .contact-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
    letter-spacing: var(--track-optical);
  }
  .contact-copy p {
    margin: 0;
    color: var(--muted);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .elsewhere {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--text-sm);
  }
  .elsewhere a {
    color: var(--muted);
  }
  .elsewhere a:hover {
    color: var(--text-strong);
  }
</style>
