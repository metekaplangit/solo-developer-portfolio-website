---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';
import SupportEmail from '../../components/SupportEmail.astro';
import { sortProducts } from '../../lib/products';
import { withBase } from '../../lib/url';
import { tie } from '../../lib/typography';
import ProductTile from '../../components/ProductTile.astro';
import { evenColumns } from '../../lib/grid';

const products = sortProducts((await getCollection('products')).map((e) => e.data));
const subject = encodeURIComponent('Support request');

// What to include in a report — kept as data so the band renders like every
// other card grid on the site rather than as a bulleted list.
const include = [
  { title: 'Which product', body: 'The app or game name, and the platform you’re on.' },
  { title: 'Which version', body: 'The version number, if you can find it. Not essential.' },
  { title: 'What happened', body: 'What you did, what happened, and what you expected instead.' },
].map((i) => ({ ...i, body: tie(i.body) }));
---

<BaseLayout
  title="Support"
  description="How to get support for any app or game — a direct email, no forms."
>
  {/* One opening: the promise on the left, the address it promises on the
      right, so the one thing this page exists to hand over is in the first
      screen beside the headline rather than a band below it. */}
  <section class="band band-lead support-top" aria-labelledby="support-h">
    <div class="support-hero">
      <p class="eyebrow" data-land="1">Support</p>
      <h1 id="support-h" class="page-title support-title" data-land="2">A real person answers.</h1>
      <p class="lede measure" data-land="3">
        {tie('Need help with an app or game? Email me directly — there\u2019s no form and no ticket number.')}
      </p>
    </div>

    <section class="panel contact reveal" aria-labelledby="contact-h">
      <p class="contact-label">Write to</p>
      <h2 id="contact-h" class="contact-title">
        <SupportEmail>{site.supportEmail}</SupportEmail>
      </h2>
      <p class="contact-note">I usually reply within 2–3 business days.</p>
      <div class="contact-actions">
        <SupportEmail>
          <a class="btn btn-primary" href={`mailto:${site.supportEmail}?subject=${subject}`}>
            Email support
          </a>
        </SupportEmail>
      </div>
    </section>
  </section>

  {/* A numbered, ruled list — the shape the product pages give "What it does" —
      rather than three more boxes under a box. */}
  <section class="band include-band" aria-labelledby="include-h">
    <h2 id="include-h" class="band-title">What to include</h2>
    <ol class="include grid-even" role="list" style="--cols-mid: 1; --cols-wide: 3;">
      {
        include.map((i, n) => (
          <li class="include-item">
            <span class="include-n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="include-title">{i.title}</h3>
            <p>{i.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band band-tail products-band" aria-labelledby="products-h">
    <h2 id="products-h" class="band-title">Supported products</h2>
    <ul
      class="tile-grid grid-even"
      role="list"
      style={`--cols-mid: ${evenColumns(products.length, 2)}; --cols-wide: ${evenColumns(products.length, 3)};`}
    >
      {
        products.map((p) => (
          <li>
            <ProductTile product={p} href={`/apps/${p.slug}/`} eager />
          </li>
        ))
      }
    </ul>
    <p class="privacy-ref">
      See the <a href={withBase('/privacy/')}>privacy overview</a> for how data
      is handled.
    </p>
  </section>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  /* The opening: hero left, the address panel right, both starting on the
     page-top line so nothing rises above where every page begins. */
  @media (min-width: 64rem) {
    .support-top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      column-gap: var(--gutter);
      align-items: start;
    }
    .support-hero .lede {
      margin-bottom: 0;
    }
  }
  @media (max-width: 63.999rem) {
    .contact {
      margin-top: var(--space-8);
    }
  }
  .contact {
    padding: clamp(var(--space-6), 2.5vw, var(--space-8));
  }
  .contact-label {
    margin: 0 0 var(--space-2);
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }
  /* The address is the heading here — it is the one thing the page exists to
     give you. Mono so it reads as data, and sized so all 24 characters stay
     on one line from 320px up (a split mid-domain reads as a typo). */
  .contact-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 4.2vw, var(--text-lg));
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-optical);
    overflow-wrap: anywhere;
  }
  .contact-note {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .include {
    column-gap: var(--space-8);
    row-gap: 0;
  }
  .include-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: var(--space-2);
    align-content: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .include-n {
    grid-row: 1 / span 2;
    padding-top: 0.2em;
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
  }
  .include-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-optical);
    color: var(--text-strong);
  }
  .include-item p {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .tile-grid > li {
    display: grid;
  }
  .privacy-ref {
    margin: var(--space-8) 0 0;
    max-width: var(--measure);
    color: var(--faint);
    font-size: var(--text-sm);
  }
  .privacy-ref a {
    color: var(--muted);
  }
  .privacy-ref a:hover {
    color: var(--text-strong);
  }
</style>
